# Copy to .env and fill in. Never commit .env.
APIFY_TOKEN=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/machtrip
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# sha256(HASH_SALT + id) is stored instead of usernames / user ids. Changing it breaks hash continuity.
HASH_SALT=
RAW_STORE_DIR=./data/raw
# Secret that must appear in the webhook URL path: POST /webhooks/apify/{WEBHOOK_SECRET}
WEBHOOK_SECRET=
# Public https URL that reaches `serve-webhook` (tunnel / reverse proxy), without trailing slash
PUBLIC_WEBHOOK_BASE_URL=
# Required header 'X-API-Key' for every request under /api/** (see README "HTTP API"). Blank = API refuses all requests.
API_KEY=

# Stage 2 (extraction): the Genway LLM gateway. All LLM calls go through it.
# e.g. https://genway.tho2kdev.com (the host used in docs/genway-llm-api.md), no trailing slash
GENWAY_BASE_URL=
GENWAY_API_KEY=
# Key of the Kong gateway in front of Genway; sent as header 'apikey' (Kong answers 401 without it)
KONG_API_KEY=
# Optional: disabled|enabled, sent as input.thinking.type. Empty = not sent. With thinking on, reasoning eats max_tokens.
GENWAY_THINKING=
